# Dependencies
node_modules/

# Build output
dist/
dist-ssr/

# Vite 根目录本地缓存（依赖预构建等，不应入库）
.vite/

# Environment secrets (use .env.example as template)
*.local
.env
.env.*
!.env.example

# Local runtime data (auth tokens, sync snapshots, image cache)
.local/

# PRD 业务内容（每个人的文档和截图不同，不提交）
# pages/doc-*/ 同时覆盖了文档三件套（.md / .meta.json / .annotations.json）
# 与 doc colocated 截图（pages/<slug>/assets/*.png）。
pages/doc-*/
pages/.active-doc.json
# 本地自动备份镜像（pages/<slug>/ → pages-backup/<slug>/）
pages-backup/
# 迁移期遗留旧截图：colocated 落到 pages/<slug>/assets/ 后，
# public/prd/ 仅保留兼容期未迁的少量历史图，不再产生新文件。
public/prd/*.png
public/prd/annotations/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Bugfix 記錄（僅本地參考，不提交）
bugfix/

# OS
.DS_Store
Thumbs.db

# 本地临时截图（调试用，不入库）
tmp-chrome-*.png

# Editor
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
